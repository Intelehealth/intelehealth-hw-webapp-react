<?xml version="1.0" encoding="UTF-8"?>
<project name="ih-hw-webapp-pr-checks" default="pr-checks" basedir=".">
    
    <!-- Properties -->
    <property name="node.version" value="22.18.0"/>
    <property name="coverage.threshold" value="50"/>
    <property name="max.bundle.size.kb" value="2048"/>
    <property name="build.dir" value="dist"/>
    <property name="coverage.dir" value="coverage"/>
    <property name="eslint.report" value="eslint-report-${node.version}.json"/>
    
    <!-- Main target that runs all PR checks -->
    <target name="pr-checks" description="Run comprehensive PR quality checks">
        <echo message="🔍 Starting Pull Request Quality Checks"/>
        <echo message="=========================================="/>
        
        <antcall target="checkout-code"/>
        <antcall target="setup-nodejs"/>
        <antcall target="install-dependencies"/>
        <antcall target="eslint-analysis"/>
        <antcall target="prettier-check"/>
        <antcall target="typescript-analysis"/>
        <antcall target="run-tests"/>
        <antcall target="generate-coverage"/>
        <antcall target="check-coverage-threshold"/>
        <antcall target="build-verification"/>
        <antcall target="bundle-analysis"/>
        <antcall target="performance-budget-check"/>
        <antcall target="security-audit"/>
        <antcall target="dependency-vulnerability-scan"/>
        <antcall target="upload-artifacts"/>
        
        <echo message="✅ All PR quality checks completed successfully!"/>
    </target>
    
    <!-- Step 1: Checkout code (simulated) -->
    <target name="checkout-code" description="📥 Checkout code">
        <echo message="📥 Checking out code..."/>
        <echo message="✅ Code checkout completed"/>
    </target>
    
    <!-- Step 2: Setup Node.js -->
    <target name="setup-nodejs" description="📦 Setup Node.js">
        <echo message="📦 Setting up Node.js ${node.version}..."/>
        <exec executable="node" failonerror="true">
            <arg value="--version"/>
        </exec>
        <echo message="✅ Node.js setup completed"/>
    </target>
    
    <!-- Step 3: Install dependencies -->
    <target name="install-dependencies" description="📦 Install dependencies">
        <echo message="📦 Installing dependencies..."/>
        <exec executable="yarn" failonerror="true">
            <arg value="install"/>
            <arg value="--frozen-lockfile"/>
        </exec>
        <echo message="✅ Dependencies installed"/>
    </target>
    
    <!-- Step 4: ESLint analysis -->
    <target name="eslint-analysis" description="🔍 ESLint analysis">
        <echo message="🔍 Running ESLint analysis..."/>
        <exec executable="yarn" failonerror="false" resultproperty="eslint.result">
            <arg value="lint"/>
            <arg value="--format"/>
            <arg value="json"/>
            <arg value="--output-file"/>
            <arg value="${eslint.report}"/>
        </exec>
        <echo message="ESLint analysis completed with exit code: ${eslint.result}"/>
    </target>
    
    <!-- Step 5: Prettier check -->
    <target name="prettier-check" description="🎨 Prettier check">
        <echo message="🎨 Running Prettier check..."/>
        <exec executable="yarn" failonerror="true">
            <arg value="format:check"/>
            <arg value="--ignore-path"/>
            <arg value=".prettierignore"/>
        </exec>
        <echo message="✅ Prettier check passed"/>
    </target>
    
    <!-- Step 6: TypeScript analysis -->
    <target name="typescript-analysis" description="🔧 TypeScript analysis">
        <echo message="🔧 Running TypeScript analysis..."/>
        <exec executable="yarn" failonerror="true">
            <arg value="type-check"/>
        </exec>
        <echo message="✅ TypeScript analysis passed"/>
    </target>
    
    <!-- Step 7: Run tests -->
    <target name="run-tests" description="🧪 Run tests">
        <echo message="🧪 Running tests..."/>
        <exec executable="yarn" failonerror="true">
            <arg value="test:run"/>
        </exec>
        <echo message="✅ Tests passed"/>
    </target>
    
    <!-- Step 8: Generate coverage report -->
    <target name="generate-coverage" description="📊 Generate coverage report">
        <echo message="📊 Generating coverage report..."/>
        <exec executable="yarn" failonerror="true">
            <arg value="test:coverage"/>
        </exec>
        <echo message="✅ Coverage report generated"/>
    </target>
    
    <!-- Step 9: Check coverage threshold -->
    <target name="check-coverage-threshold" description="📊 Check coverage threshold">
        <echo message="🔍 Checking coverage threshold..."/>
        <exec executable="grep" failonerror="false" resultproperty="coverage.grep.result" outputproperty="coverage.percentage">
            <arg value="-o"/>
            <arg value='"lines":{"total":[0-9]*,"covered":[0-9]*,"skipped":[0-9]*,"pct":[0-9.]*}'/>
            <arg value="${coverage.dir}/coverage-summary.json"/>
        </exec>
        <exec executable="grep" failonerror="false" resultproperty="coverage.pct.result" outputproperty="coverage.pct">
            <arg value="-o"/>
            <arg value='"pct":[0-9.]*'/>
            <arg value="${coverage.dir}/coverage-summary.json"/>
        </exec>
        <exec executable="cut" failonerror="false" outputproperty="coverage.value">
            <arg value="-d"/>
            <arg value=":"/>
            <arg value="-f2"/>
            <redirector inputstring="${coverage.pct}"/>
        </exec>
        <echo message="Current coverage: ${coverage.value}%"/>
        <echo message="Coverage threshold: ${coverage.threshold}%"/>
        <echo message="✅ Coverage check completed: ${coverage.value}% (threshold: ${coverage.threshold}%)"/>
    </target>
    
    <!-- Step 10: Build verification -->
    <target name="build-verification" description="🏗️ Build verification">
        <echo message="🏗️ Running build verification..."/>
        <exec executable="yarn" failonerror="true">
            <arg value="build"/>
        </exec>
        <echo message="✅ Build verification passed"/>
    </target>
    
    <!-- Step 11: Bundle analysis -->
    <target name="bundle-analysis" description="📊 Bundle analysis">
        <echo message="📊 Analyzing bundle size..."/>
        <exec executable="yarn" failonerror="true">
            <arg value="analyze"/>
        </exec>
        <echo message="✅ Bundle analysis completed"/>
    </target>
    
    <!-- Step 12: Performance budget check -->
    <target name="performance-budget-check" description="📈 Performance budget check">
        <echo message="📈 Checking performance budget..."/>
        
        <!-- Get bundle size in KB -->
        <exec executable="du" failonerror="true" outputproperty="bundle.size.kb">
            <arg value="-sk"/>
            <arg value="${build.dir}"/>
        </exec>
        <exec executable="cut" failonerror="true" outputproperty="bundle.size.kb.value">
            <arg value="-f1"/>
            <redirector inputstring="${bundle.size.kb}"/>
        </exec>
        
        <!-- Get human readable size -->
        <exec executable="du" failonerror="true" outputproperty="bundle.size.display">
            <arg value="-sh"/>
            <arg value="${build.dir}"/>
        </exec>
        <exec executable="cut" failonerror="true" outputproperty="bundle.size.display.value">
            <arg value="-f1"/>
            <redirector inputstring="${bundle.size.display}"/>
        </exec>
        
        <echo message="Bundle size: ${bundle.size.display.value} (${bundle.size.kb.value} KB)"/>
        
        <!-- Check if bundle size is within budget -->
        <echo message="Bundle size check: ${bundle.size.kb.value} KB (max: ${max.bundle.size.kb} KB)"/>
        <echo message="✅ Bundle size check completed"/>
    </target>
    
    <!-- Step 13: Security audit -->
    <target name="security-audit" description="🔒 Security audit">
        <echo message="🔍 Running security audit..."/>
        <echo message="Checking for high-level vulnerabilities only..."/>
        
        <!-- Yarn audit -->
        <exec executable="yarn" failonerror="false" resultproperty="yarn.audit.result">
            <arg value="audit"/>
            <arg value="--level"/>
            <arg value="high"/>
        </exec>
        <echo message="Yarn audit completed with exit code: ${yarn.audit.result}"/>
        
        <!-- NPM audit -->
        <exec executable="npm" failonerror="false" resultproperty="npm.audit.result">
            <arg value="audit"/>
            <arg value="--audit-level"/>
            <arg value="high"/>
        </exec>
        <echo message="NPM audit completed with exit code: ${npm.audit.result}"/>
        
        <echo message="⚠️ Security audit completed - check output above for vulnerabilities"/>
    </target>
    
    <!-- Step 14: Dependency vulnerability scan -->
    <target name="dependency-vulnerability-scan" description="🔍 Dependency vulnerability scan">
        <echo message="🔍 Running dependency vulnerability scan..."/>
        <exec executable="npx" failonerror="false" resultproperty="audit.ci.result">
            <arg value="audit-ci"/>
            <arg value="--config"/>
            <arg value=".audit-ci.json"/>
        </exec>
        <echo message="Dependency vulnerability scan completed with exit code: ${audit.ci.result}"/>
    </target>
    
    <!-- Step 15: Upload artifacts (simulated) -->
    <target name="upload-artifacts" description="📦 Upload artifacts">
        <echo message="📦 Uploading build artifacts..."/>
        <echo message="📦 Uploading quality reports..."/>
        <echo message="✅ Artifacts upload completed (simulated)"/>
    </target>
    
    <!-- Individual check targets for running specific checks -->
    <target name="lint-only" description="Run only linting checks">
        <antcall target="eslint-analysis"/>
        <antcall target="prettier-check"/>
    </target>
    
    <target name="test-only" description="Run only testing checks">
        <antcall target="run-tests"/>
        <antcall target="generate-coverage"/>
        <antcall target="check-coverage-threshold"/>
    </target>
    
    <target name="build-only" description="Run only build checks">
        <antcall target="build-verification"/>
        <antcall target="bundle-analysis"/>
        <antcall target="performance-budget-check"/>
    </target>
    
    <target name="security-only" description="Run only security checks">
        <antcall target="security-audit"/>
        <antcall target="dependency-vulnerability-scan"/>
    </target>
    
    <!-- Clean target -->
    <target name="clean" description="Clean build artifacts">
        <echo message="🧹 Cleaning build artifacts..."/>
        <delete dir="${build.dir}" failonerror="false"/>
        <delete dir="${coverage.dir}" failonerror="false"/>
        <delete file="${eslint.report}" failonerror="false"/>
        <echo message="✅ Clean completed"/>
    </target>
    
    <!-- Help target -->
    <target name="help" description="Show available targets">
        <echo message="Available targets:"/>
        <echo message="  pr-checks        - Run all PR quality checks (default)"/>
        <echo message="  lint-only        - Run only linting checks (ESLint + Prettier)"/>
        <echo message="  test-only        - Run only testing checks (tests + coverage)"/>
        <echo message="  build-only       - Run only build checks (build + bundle analysis)"/>
        <echo message="  security-only    - Run only security checks (audit + vulnerability scan)"/>
        <echo message="  clean            - Clean build artifacts"/>
        <echo message="  help             - Show this help message"/>
        <echo message=""/>
        <echo message="Individual check targets:"/>
        <echo message="  checkout-code, setup-nodejs, install-dependencies"/>
        <echo message="  eslint-analysis, prettier-check, typescript-analysis"/>
        <echo message="  run-tests, generate-coverage, check-coverage-threshold"/>
        <echo message="  build-verification, bundle-analysis, performance-budget-check"/>
        <echo message="  security-audit, dependency-vulnerability-scan, upload-artifacts"/>
    </target>
    
</project>
