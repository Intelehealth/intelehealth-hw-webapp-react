echo "🔍 Running pre-commit checks..."

# Run lint-staged to format and lint staged files
echo "📝 Formatting and linting staged files..."
npx lint-staged

# Type checking
echo "🔧 Running TypeScript type check..."
npx tsc --noEmit

# Run tests
